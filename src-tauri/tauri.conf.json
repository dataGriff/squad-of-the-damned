{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squad of the Damned",
  "version": "0.1.0",
  "identifier": "com.hungovercoders.squadofthedamned",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Squad of the Damned",
        "width": 1024,
        "height": 960,
        "minWidth": 512,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
